# Port for the Express server. Render sets this automatically.
PORT=4000

# Deployed Vercel frontend URL for CORS. Set this on Render, e.g.:
# FRONTEND_URL=https://raildetour.vercel.app
FRONTEND_URL=

# Get a RailRadar key at https://railradar.in/ to enable live train data.
RAILRADAR_API_KEY=

# Google Maps Routes API key. Keep this server-side.
GOOGLE_MAPS_API_KEY=
