# Google Maps JavaScript API key for the interactive map.
# Leave empty to use the map-fallback placeholder.
VITE_GOOGLE_MAPS_API_KEY=

# Backend API URL. Leave empty for local development (Vite proxy handles it).
# Set to your Render backend URL for production, e.g.:
# VITE_API_BASE_URL=https://raildetour-api.onrender.com
VITE_API_BASE_URL=
